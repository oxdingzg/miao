{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": [
    "CI",
    "MIAO_DISABLE_SHARE"
  ],
  "globalPassThroughEnv": [
    "CI",
    "MIAO_DISABLE_SHARE"
  ],
  "tasks": {
    "typecheck": {},
    "@miao/native#build": {
      "cache": false,
      "outputs": [
        "src/miao-native.node"
      ]
    },
    "build": {
      "dependsOn": [],
      "outputs": [
        "dist/**"
      ]
    },
    "@miao/core#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/app#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/ui#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/session-ui#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/client#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/http-recorder#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/httpapi-codegen#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/script#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/codemode#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/effect-drizzle-sqlite#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/llm#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@miao/remote-control#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
