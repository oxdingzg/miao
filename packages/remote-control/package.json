{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@miao/remote-control",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "bun test",
    "check:browser:enrollment": "bun script/check-browser-enrollment.ts",
    "check:browser": "bun script/check-browser.ts && bun script/check-browser-account.ts",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.browser.json",
    "hub": "bun src/hub-main.ts",
    "build:web": "bun script/build-web.ts",
    "check:web": "bun run build:web && bun script/check-web.ts",
    "check:web:mobile": "bun run build:web && bun script/check-web.ts --mobile --scan --social",
    "check:web:enrollment": "bun run build:web && bun script/check-web-runtime.ts --account-enrollment",
    "check:web:runtime": "bun run build:web && bun script/check-web-runtime.ts && bun script/check-web-runtime.ts --project-scope && bun script/check-web-runtime.ts --live"
  },
  "dependencies": {
    "effect": "catalog:",
    "@miao/schema": "workspace:*",
    "better-auth": "1.7.7",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "imports": {
    "#grant-lock": {
      "bun": "./src/grant-lock.bun.ts",
      "node": "./src/grant-lock.node.ts",
      "default": "./src/grant-lock.bun.ts"
    }
  }
}
