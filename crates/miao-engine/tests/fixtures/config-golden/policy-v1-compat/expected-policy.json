{
  "mode": "workspace",
  "auto": false,
  "allow_process": true,
  "allow_background": true,
  "allow_subagents": true,
  "allow_mcp": true,
  "allow_web": true,
  "allow_wakeup": true,
  "allow_cron": true,
  "process_network": true,
  "sandbox": false,
  "writable_roots": [],
  "rules": [
    {
      "tool": "bash",
      "path": "**",
      "decision": "allow"
    },
    {
      "tool": "{apply_patch,edit_file,write_file}",
      "path": "**",
      "decision": "deny"
    },
    {
      "tool": "{apply_patch,edit_file,write_file}",
      "path": "**",
      "decision": "ask"
    }
  ],
  "approval_timeout_ms": 60000,
  "max_provider_turns": null,
  "continuation_min_interval_ms": 30000,
  "budget": null
}
