      }
    },
    {
      "name": "configured-deny-beats-a-later-saved-allow",
      "request": {
        "actions": [
          "bash"
        ],
        "resources": [
          "git push origin"
        ],
        "configured": [
          {
            "action": "bash",
            "resource": "git push *",
            "effect": "deny"
          }
        ],
        "saved": [
          {
            "action": "bash",
            "resource": "git *",
            "effect": "allow"
          }
        ]
      },
      "expected": {
        "effect": "deny",
        "rules": [
          {
            "action": "bash",
            "resource": "git push *",
            "effect": "deny"
          }
        ]
      }
    },
