            "effect": "allow"
          },
          {
            "action": "bash",
            "resource": "rm *",
            "effect": "deny"
          }
        ]
      },
      "expected": {
        "effect": "deny",
        "rules": [
          {
            "action": "bash",
            "resource": "*",
            "effect": "allow"
          },
          {
            "action": "bash",
            "resource": "rm *",
            "effect": "deny"
          }
        ]
      }
    },
    {
      "name": "priority-inverts-with-rule-order",
      "request": {
        "actions": [
          "bash"
        ],
        "resources": [
          "rm -rf x"
        ],
        "configured": [
          {
            "action": "bash",
