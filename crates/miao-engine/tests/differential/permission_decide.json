            "effect": "deny"
          },
          {
            "action": "bash",
            "resource": "*",
            "effect": "allow"
          }
        ]
      },
      "expected": {
        "effect": "allow",
        "rules": [
          {
            "action": "bash",
            "resource": "rm *",
            "effect": "deny"
          },
          {
            "action": "bash",
            "resource": "*",
            "effect": "allow"
          }
        ]
      }
    },
