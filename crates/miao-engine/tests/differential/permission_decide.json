{
  "semantics": "configured-deny-first-then-last-match-v1",
  "cases": [
    {
      "name": "explicit-without-an-agent-ruleset-still-filters-the-catch-all",
      "request": {
        "actions": [
          "sandbox-escape"
        ],
        "resources": [
          "host"
        ],
        "explicit": true
      },
      "expected": {
        "effect": "ask",
        "rules": []
      }
    },
    {
      "name": "two-question-marks-deny-one-supplementary-character",
      "request": {
        "actions": [
          "read"
        ],
        "resources": [
          "😀.txt"
        ],
        "configured": [
          {
            "action": "read",
            "resource": "*",
            "effect": "allow"
          },
          {
            "action": "read",
            "resource": "??.txt",
            "effect": "deny"
          }
        ]
      },
      "expected": {
        "effect": "deny",
        "rules": [
          {
            "action": "read",
            "resource": "*",
            "effect": "allow"
          },
          {
            "action": "read",
            "resource": "??.txt",
            "effect": "deny"
          }
        ]
      }
    },
    {
      "name": "one-question-mark-does-not-deny-a-surrogate-pair",
      "request": {
        "actions": [
          "read"
        ],
        "resources": [
          "😀.txt"
        ],
        "configured": [
          {
            "action": "read",
            "resource": "*",
            "effect": "allow"
          },
          {
            "action": "read",
            "resource": "?.txt",
            "effect": "deny"
          }
        ]
      },
      "expected": {
        "effect": "allow",
        "rules": [
          {
            "action": "read",
            "resource": "*",
            "effect": "allow"
          },
          {
            "action": "read",
            "resource": "?.txt",
            "effect": "deny"
          }
        ]
      }
    },
    {
      "name": "two-question-marks-do-not-grant-one-bmp-character",
