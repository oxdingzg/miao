# PowerShell grammar in syntect's own YAML dialect: `contexts` of `match` plus
# `push`/`pop`, since that loader has no `repository` and no `begin`/`end`.
#
# The bundled set has no PowerShell definition at all — `two-face` follows bat,
# whose PowerShell grammar is a link to another repository — so this one is
# authored here. It covers what a transcript actually shows: comments, the four
# string forms, variables, cmdlet names with their parameters, keywords, types,
# numbers, and operators. Anything else keeps the plain text colour.
name: PowerShell
file_extensions: [ps1, psm1, psd1]
scope: source.powershell
contexts:
  main:
    - match: '<#'
      scope: comment.block.powershell punctuation.definition.comment.begin.powershell
      push: [block_comment]
    - match: '(?<![^\s])(#).*'
      captures:
        0: comment.line.powershell
        1: punctuation.definition.comment.powershell
    - match: '@"'
      scope: string.quoted.double.heredoc.powershell punctuation.definition.string.begin.powershell
      push: [here_double]
    - match: "@'"
      scope: string.quoted.single.heredoc.powershell punctuation.definition.string.begin.powershell
      push: [here_single]
    - match: "'"
      scope: string.quoted.single.powershell punctuation.definition.string.begin.powershell
      push: [single_quoted]
    - match: '"'
      scope: string.quoted.double.powershell punctuation.definition.string.begin.powershell
      push: [double_quoted]
    - match: '(?i)\b(begin|break|catch|class|continue|data|define|do|dynamicparam|else|elseif|end|enum|exit|filter|finally|for|foreach|from|function|hidden|if|in|inlinescript|parallel|param|process|return|sequence|static|switch|throw|trap|try|until|using|var|while|workflow)\b'
      scope: keyword.control.powershell
    - match: '(?i)(?<![\w`])-(?:and|as|band|bnot|bor|bxor|ceq|cge|cgt|cle|clike|clt|cmatch|cne|cnotcontains|cnotlike|cnotmatch|contains|creplace|csplit|eq|f|ge|gt|icontains|ieq|ige|igt|ile|ilike|ilt|imatch|in|ine|inotcontains|inotlike|inotmatch|ireplace|is|isnot|isplit|join|le|like|lt|match|ne|not|notcontains|notin|notlike|notmatch|or|replace|shl|shr|split|xor)\b'
      scope: keyword.operator.word.powershell
    - match: '===|!==|==|!=|<=|>=|\+\+|--|\+=|-=|\*=|/=|%=|&&|\|\||::|[+*/%=!<>|&]'
      scope: keyword.operator.powershell
    - match: '\b0[xX][0-9a-fA-F]+\b|\b\d+(?:\.\d+)?(?:[eE][-+]?\d+)?(?:[kKmMgGtTpP][bB])?\b'
      scope: constant.numeric.powershell
    - match: '\b([A-Z][a-z]+)-[A-Z][A-Za-z0-9]+\b'
      scope: entity.name.function.powershell
    - match: '(?<![\w`])-([A-Za-z_][A-Za-z0-9_]*)'
      captures:
        0: variable.parameter.powershell
    - match: '\$(?:\w+|\{[^}]*\})|[@$?^]'
      scope: variable.other.powershell
    - match: '\[(?!(?:\$|\d))[A-Za-z_][\w.]*\]'
      scope: entity.name.type.powershell
    - match: '(?i)\b(true|false|null)\b'
      scope: constant.language.powershell
    - match: '[(){}\[\]]'
      scope: punctuation.section.powershell
    - match: '(?<=[\w)\]])(?:\.)(?=[A-Za-z_])'
      scope: punctuation.accessor.powershell

  block_comment:
    - meta_scope: comment.block.powershell
    - match: '#>'
      scope: punctuation.definition.comment.end.powershell
      pop: true

  single_quoted:
    - meta_scope: string.quoted.single.powershell
    - match: "''"
      scope: constant.character.escape.powershell
    - match: "'"
      scope: punctuation.definition.string.end.powershell
      pop: true

  double_quoted:
    - meta_scope: string.quoted.double.powershell
    - match: '`.'
      scope: constant.character.escape.powershell
    - match: '\$(?:\w+|\{[^}]*\}|[?$^])'
      scope: variable.other.powershell
    - match: '"'
      scope: punctuation.definition.string.end.powershell
      pop: true

  here_single:
    - meta_scope: string.quoted.single.heredoc.powershell
    - match: "^'@"
      scope: punctuation.definition.string.end.powershell
      pop: true

  here_double:
    - meta_scope: string.quoted.double.heredoc.powershell
    - match: '`.'
      scope: constant.character.escape.powershell
    - match: '\$(?:\w+|\{[^}]*\}|[?$^])'
      scope: variable.other.powershell
    - match: '^"@'
      scope: punctuation.definition.string.end.powershell
      pop: true
