#!/bin/sh
set -e
# Check if bun version matches package.json
# keep in sync with packages/script/src/index.ts semver qualifier
bun -e '
import { semver } from "bun";
const pkg = await Bun.file("package.json").json();
const expectedBunVersion = pkg.packageManager?.split("@")[1];
if (!expectedBunVersion) {
  throw new Error("packageManager field not found in root package.json");
}
const expectedBunVersionRange = `^${expectedBunVersion}`;
if (!semver.satisfies(process.versions.bun, expectedBunVersionRange)) {
  throw new Error(`This script requires bun@${expectedBunVersionRange}, but you are using bun@${process.versions.bun}`);
}
if (process.versions.bun !== expectedBunVersion) {
  console.warn(`Warning: Bun version ${process.versions.bun} differs from expected ${expectedBunVersion}`);
}
'
if command -v gitleaks >/dev/null 2>&1; then
  # Scan the commits this push sends, and only those. Scanning every branch that is
  # not yet on a remote (`--branches --not --remotes`) made one stale local branch
  # block every push from the machine, including pushes that never touched it.
  # Pre-push receives one line per ref:
  #   <local ref> <local sha> <remote ref> <remote sha>
  # and an all-zero sha means "the ref does not exist on that side".
  status=0
  scanned=0
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    if [ -z "$local_sha" ]; then
      continue
    fi
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
      continue
    fi
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      # A new ref: every commit it reaches that the remote does not already have.
      range="$local_sha --not --remotes=${1:-origin}"
    else
      range="$remote_sha..$local_sha"
    fi
    scanned=1
    gitleaks git --redact --no-banner --exit-code 1 --log-opts="$range" . || status=1
  done
  if [ "$scanned" = "0" ]; then
    # No refs on stdin (invoked by hand, or a git that passes none). Fall back to the
    # branch that is checked out, rather than scanning nothing at all.
    gitleaks git --redact --no-banner --exit-code 1 --log-opts="HEAD --not --remotes=${1:-origin}" . ||
      status=1
  fi
  if [ "$status" != "0" ]; then
    exit "$status"
  fi
else
  echo "gitleaks not found, skipping secret scan"
fi
# No `bun typecheck` here: CI runs it as a required check on every PR, and a
# full turbo typecheck inside the hook spawns ~2 GB tsgo processes per task.
# Concurrent pushes from parallel sessions then pile up to machine-wide
# swapping (observed: >37 GB private memory from stacked `tsgo --noEmit`).
# Run `bun typecheck` deliberately when you want the local gate.
